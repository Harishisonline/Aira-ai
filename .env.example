# ===== Supabase Postgres connection (for the Python worker) =====
# Get from https://supabase.com/dashboard -> Project -> Settings -> Database ->
# Connection string -> URI. The pooler (port 6543) is the recommended host
# because it's reachable from most networks; the direct host
# (db.<ref>.supabase.co:5432) only resolves from Supabase's internal network.
# If you can use neither, run the worker on a Supabase-supported host
# (Fly.io, Railway, Render, your own VPS with allow-listed egress).
DATABASE_URL=postgresql://postgres.svqugnhrcwugdjgobdqs:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ===== Groq (LLM) =====
# Get at https://console.groq.com/keys
GROQ_API_KEY=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

# ===== Resend (transactional email) =====
# Get at https://resend.com/api-keys
RESEND_API_KEY=re_EU6QM7iZ_GZ3hVjaUQWCE5bJjLPdxrZyx
RESEND_FROM="Aira AI <onresend.com>"
# ===== AQI data source =====
# OPENAQ_KEY is optional. If empty, the worker uses the deterministic mock fetcher
# (realistic 30-day history seeded per station). If set, Aira pulls live data from
# OpenAQ's free global aggregator, which mirrors Indian government stations.
OPENAQ_KEY=
AQI_FALLBACK_TO_MOCK=true

# ===== Service URLs (local dev defaults; override in production) =====
WEB_URL=http://localhost:3000
WORKER_URL=http://localhost:8000
WORKER_INTERNAL_TOKEN=dev-internal-token-change-in-prod
