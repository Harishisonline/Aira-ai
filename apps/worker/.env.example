# ----- Groq LLM (chat + advisory + compare reports) -----
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_PRIMARY_MODEL=qwen/qwen3-32b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# ----- Resend (transactional email) -----
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM=Aira AI <onresend.com>

# ----- AQI data source -----
# Empty key = mock fetcher (deterministic 30-day history per station)
# Set OPENAQ_KEY for live OpenAQ data (free, mirrors Indian government stations)
OPENAQ_KEY=
AQI_FALLBACK_TO_MOCK=true

# ----- Service URLs -----
WEB_URL=http://localhost:3000
WORKER_URL=http://localhost:8000
WORKER_INTERNAL_TOKEN=dev-internal-token-change-in-prod

# ----- App metadata -----
APP_VERSION=1.2.0