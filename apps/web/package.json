{
  "name": "aira-ai-web",
  "version": "1.3.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "rm -rf .next/standalone/.next/static && cp -R .next/static .next/standalone/.next/static && cp -R public .next/standalone/public 2>/dev/null || true",
    "start": "node .next/standalone/server.js",
    "start:compat": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "backtest:e2e": "python3 ../../tests/backtest_e2e.py",
    "backtest:openaq": "python3 ../../tests/backtest_openaq.py",
    "backtest:ingest": "python3 ../../tests/backtest_ingest_fallback.py",
    "backtest:worker": "python3 ../../tests/worker_smoke.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "groq-sdk": "^0.7.0",
    "next": "15.0.3",
    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "resend": "^4.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.0.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
